# Application
ENVIRONMENT=development
PROJECT_NAME='BMW Catalog API'
SECRET_KEY=replace-this-with-a-random-secret-before-running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS='["http://localhost:5173"]'

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bmw_catalog
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# S3 image storage. Leave empty to disable image uploads locally.
AWS_BUCKET_NAME=
AWS_REGION=eu-central-1
AWS_CLOUDFRONT_DOMAIN=
PRODUCT_IMAGE_UPLOAD_ALLOWED_USER_IDS='[]'
